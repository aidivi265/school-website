# ==============================================================================
# DECENT PUBLIC SCHOOL - ENVIRONMENT VARIABLES
# Copy to .env.local for local development or set in Netlify dashboard for production
# ==============================================================================

# Supabase Project URL & Anon Key (From Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (NEVER expose to client - used only in server routes/migrations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Default School Identifier for Multi-School Architecture
NEXT_PUBLIC_DEFAULT_SCHOOL_SLUG=decent-public-school

# Site URL for metadata / sitemap
NEXT_PUBLIC_SITE_URL=https://decentpublicschoolrohini.edu.in
